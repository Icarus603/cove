{
  "sourceLanguage": "en",
  "strings": {
    "Plugins run as programs with your user permissions. Only switch on ones you trust.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins run as programs with your user permissions. Only switch on ones you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件是以你的用户权限运行的程序，只开启你信任的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛是以你的使用者權限執行的程式，只開啟你信任的。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインはあなたの権限で動くプログラムです。信頼できるものだけを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인은 사용자 권한으로 실행되는 프로그램입니다. 신뢰하는 것만 켜세요."
          }
        }
      }
    },
    "No plugins found in the plugins folder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plugins found in the plugins folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件文件夹里没有找到插件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛資料夾裡找不到外掛。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインフォルダにプラグインが見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인 폴더에 플러그인이 없습니다."
          }
        }
      }
    },
    "Open plugins folder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open plugins folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开插件文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟外掛資料夾"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインフォルダを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인 폴더 열기"
          }
        }
      }
    },
    "Reload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新载入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 불러오기"
          }
        }
      }
    }
  },
  "version": "1.0"
}