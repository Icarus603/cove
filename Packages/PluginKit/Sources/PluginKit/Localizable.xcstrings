{
  "sourceLanguage" : "en",
  "strings" : {
    "Plugins run as programs with your user permissions. Only switch on ones you trust." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins run as programs with your user permissions. Only switch on ones you trust."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件是以你的用户权限运行的程序，只开启你信任的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外掛是以你的使用者權限執行的程式，只開啟你信任的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインはあなたの権限で動くプログラムです。信頼できるものだけを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인은 사용자 권한으로 실행되는 프로그램입니다. 신뢰하는 것만 켜세요."
          }
        }
      }
    },
